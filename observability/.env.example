# Copy to observability/.env (untracked) and set a password. Compose refuses to start with it empty.
GRAFANA_ADMIN_PASSWORD=
# Optional: other host ports (both bind 127.0.0.1), a different targets file, retention.
# OBS_PROMETHEUS_PORT=9091
# OBS_GRAFANA_PORT=3000
# OBS_TARGETS_FILE=./prometheus/targets/local.yml
# OBS_RETENTION=2d
