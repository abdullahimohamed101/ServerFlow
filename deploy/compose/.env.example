# Configuration for `make dev-up` (docs/operations/docker-deployment.md). Copied to ./.env on the first run.
# NO SECRETS live here: passwords and tokens are generated into .dev/ (gitignored) by scripts/dev-up.sh.
# Values may only contain letters, digits and . _ : / @ - ; anything else is refused before Docker starts.

# Which parts of the stack to run: core (control plane, mock workers, agents, gateway), data (PostgreSQL,
# Redis: API keys and rate limits), events (Redpanda, usage consumer), observability (Prometheus, Grafana),
# tracing (Jaeger). Comma separated. `core` alone runs with authentication and rate limiting off.
PROFILES=core,data,events,observability,tracing

# Gateway replicas. More than one starts an nginx load balancer in front of them.
GATEWAYS=1

# Host ports, all bound to 127.0.0.1 only. Leave CONTROL_PLANE_PORT empty to not publish the control plane.
GATEWAY_PORT=18080
CONTROL_PLANE_PORT=19090
PROMETHEUS_PORT=19091
GRAFANA_PORT=13000
JAEGER_UI_PORT=16686

# Scheduling strategy of the gateway: random, round-robin, least-active, least-queue.
SF_STRATEGY=round-robin

# Fault tolerance of the gateway (Phase 15, ADR-020, docs/operations/resilience.md): circuit breakers, retry budget, bounded queue and
# shedding, drain. on is the default; off is the kill switch (recreate the gateway after changing it).
SF_RESILIENCE_MODE=on

# Mock worker sizing (all three) and per-worker knobs. A failure rate above 0 makes that worker fail that fraction
# of requests in the given mode (error, unavailable, drop, midstream); changing one recreates only that worker.
WORKER_CONCURRENCY=8
WORKER_QUEUE=64
MOCK_1_TPS=100
MOCK_1_TTFT=100ms
MOCK_1_FAILURE_RATE=0
MOCK_1_FAILURE_MODE=error
MOCK_1_STARTUP_DELAY=0s
MOCK_1_SEED=1
MOCK_2_TPS=60
MOCK_2_TTFT=150ms
MOCK_2_FAILURE_RATE=0
MOCK_2_FAILURE_MODE=error
MOCK_2_STARTUP_DELAY=0s
MOCK_2_SEED=2
MOCK_3_TPS=20
MOCK_3_TTFT=300ms
MOCK_3_FAILURE_RATE=0
MOCK_3_FAILURE_MODE=error
MOCK_3_STARTUP_DELAY=0s
MOCK_3_SEED=3

# Fraction of requests traced (0 to 1).
TRACING_SAMPLE_RATIO=1.0

# 1 keeps PostgreSQL, Redis, Redpanda, Prometheus and Grafana data in named volumes across `make dev-down`.
PERSIST=0

# Prometheus retention.
PROMETHEUS_RETENTION=2d

# Compose project name; change it to run a second copy beside this one (also change the ports above).
COMPOSE_PROJECT_NAME=serverflow-dev

# Image references. The defaults are digest-pinned and none comes from Docker Hub; override one to use another
# mirror (for example docker.redpanda.com/redpandadata/redpanda:v25.1.1 when you are logged in to Docker Hub).
# POSTGRES_IMAGE=
# REDIS_IMAGE=
# REDPANDA_IMAGE=
# PROMETHEUS_IMAGE=
# GRAFANA_IMAGE=
# JAEGER_IMAGE=
# NGINX_IMAGE=
