# The pinned versions of everything the Kubernetes workflow runs (Phase 17, docs/operations/kubernetes-deployment.md).
# One place: scripts/k8s-up.sh and scripts/k8s-tool.sh read it (it is data, never sourced), tests/k8s compares it with
# kind/cluster.yaml and the CI workflows. NAME=VALUE only, no quotes.
#
# Resolved 2026-10-22 (evidence: docs/benchmarks/phase-17-kubernetes.md). Kubernetes 1.36 is the minor before the newest
# kind release's default (1.37.0, three weeks old on that day); kubectl is within the supported skew of the node.
KUBERNETES_VERSION=v1.36.4
KIND_VERSION=v0.33.0
KIND_LINUX_AMD64_SHA256=aee6151561422756b764a4ae28e7f44cda5af5a9eead3cc9985112b1de8d8e0d
# The kindest/node image of the kind release notes, through Google's anonymous mirror (same index digest as Docker Hub).
KIND_NODE_IMAGE=mirror.gcr.io/kindest/node:v1.36.4@sha256:099e049362a1526b2db71494e1947aae99bd16290d7c895f2b7ea312e3cbfaed
KUBECTL_LINUX_AMD64_SHA256=8b8f088da2dab964f853b38464033b1be15ede2839eca751482357c45abdd05a
# Used when kubectl / kubeconform of exactly these versions are not on PATH (nothing is installed on the host).
KUBECTL_IMAGE=registry.k8s.io/kubectl:v1.36.4@sha256:b8d523e7b8cdc5e3caa0f8891ee9f504abf137dec786e6e0ddd33e4f272c2f13
KUBECONFORM_VERSION=v0.8.0
KUBECONFORM_LINUX_AMD64_SHA256=9bc2bffbf71f261128533edaf912153948b7ff238f9a531ae6d34466ec287883
KUBECONFORM_IMAGE=ghcr.io/yannh/kubeconform:v0.8.0@sha256:faffaf43f95aa6425306e1ab8d6fcad72acb9049158f38e574c085ea1ec0f64e
